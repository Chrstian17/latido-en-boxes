---
import "../styles/styles.css";
import "../styles/design-tokens.css";
import Card from "../Components/Card.astro";
import Header from "../Components/Header.astro";
import Boton from "../Components/Boton.astro";
import Botonblanco from "../Components/Boton blanco.astro";
import Footer from "../Components/Footer.astro";
import Iconotexto from "../Components/Icono-texto.astro";
import Carruselinicial from "../Components/Carrusel inicial.astro";
import Carruselfull from "../Components/Carrusel full.astro";
import Carruseltienda from "../Components/Carrusel tienda.astro";
import IconoTexto from "../Components/Icono-texto.astro";
import Formulario from "../Components/Formulario.astro";
import Cifra from "../Components/Cifras.astro";
import CarruselFull from "../Components/Carrusel full.astro";
import CarruselTienda from "../Components/Carrusel tienda.astro";
import Cifras from "../Components/Cifras.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Latido en Boxes</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,100..900,0..100,0..1;1,9..144,100..900,0..100,0..1&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/bold/style.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/fill/style.css"
    />
  </head>
  <body>
    <!-- HERO -->
    <section class="section hero">
      <div class="overlay">
        <div class="content-wrapper">
          <div class="hero__content stack">
            <h1>Latido<br />en Boxes</h1>
            <p class="body-l">
              Una asociación solidaria de apoyo al galgo que une el mundo del
              motor con la protección animal.
            </p>
            
              <a href="#como-ayudar" class="btn btn--primary">
                Quiero ayudar<i class="ph ph-heart"></i></a>
              
              
            
          </div>
        </div>
      </div>
    </section>

    <!-- ABOUT -->

    <section class="about asimetric-section ">
      <div class="content-wrapper">
        <div class="about__content stack">
          <div class="about__block">
            <h2 >Nuestra <br> misión</h2>
            <p class="body-m">
              Es <strong>impulsar, financiar y dar visibilidad</strong> al trabajo
              de las protectoras de galgos en toda España
            </p>
          </div>
          <div class="about__block">
            <h2 >Nuestra <br>  filosofía</h2>
            <p class="body-m">
              Transparencia, cercanía y unión con el mundo de la automoción para <strong
                >crear comunidad y dar visibilidad.</strong
              >
            </p>
          </div>
        </div>
        <Carruselinicial />
      </div>
    </section>

    <!-- NUMBERS -->

    <section class="section numbers card-grid" >
      <div class="section__header numbers__header stack">
        <h2 class="heading-l">Una realidad que no podemos ignorar</h2>
        <p class="body-m">
          Cuando los galgos no cumplen con las expectativas cinegéticas, muchos
          son abandonados, maltratados o incluso asesinados.
        </p>
      </div>

      <div class="content-wrapper">
        <Cifras></Cifras>
      </div>
    </section>


    <!-- ACTIONS -->

    <section class="section actions">
      <div class="section__header stack">
        <h2>Unidos por los latidos</h2>
        <p class="body-m">
          Nuestra asociación actúa como una plataforma de apoyo y conexión entre
          las protectoras de galgos y los donantes, estructurada en cuatro
          líneas de acción.
        </p>
      </div>

      <div class="content-wrapper">
        <div class="stack">
          <details name="accordion">
            <summary class="heading-m">Eventos solidarios</summary>
                <p class="body-m">En primer lugar, organizamos <strong>eventos solidarios vinculados al mundo del motor</strong
              >, como rutas benéficas, concentraciones con clubs y pilotos y
              encuentros con talleres o concesionarios, destinando íntegramente
              las inscripciones y aportaciones a las protectoras colaboradoras.</p>
          </details>
          <details name="accordion">
            <summary class="heading-m">Campañas de concienciación</summary>
                <p class="body-m">En segundo lugar, desarrollamos <strong
              >campañas de concienciación y visibilidad</strong
            > mediante colaboraciones con influencers, figuras del motor y medios,
            generando contenido que difunde la realidad del galgo y su abandono, además
            de impartir charlas en colegios, talleres y eventos.</p>
          </details>
          <details name="accordion">
            <summary class="heading-m">Merchandising solidario</summary>
                <p class="body-m">En tercer lugar, producimos <strong
              >merchandising solidario</strong
            > como camisetas, pegatinas y accesorios personalizados, cuyos beneficios
            permiten financiar necesidades urgentes de las asociaciones.</p>
          </details>
          <details name="accordion">
            <summary class="heading-m">Red de apoyo</summary>
                <p class="body-m">Finalmente, articulamos una <strong>red de apoyo</strong
            > que canaliza donaciones económicas y materiales, así como servicios
            como medicación, pienso, voluntariado, casas de acogida y soporte especializado
            en comunicación, diseño y promoción. Todo ello se desarrolla con la intención
            de crear, a medio o largo plazo, un refugio propio que amplíe nuestra
            capacidad de rescate y cuidado de galgos.</p>
          </details>

        </div>
        <div class="stack">
          <img src="/assets/galgo-taller.webp" alt="" />
        </div>
      </div>
    </section>

    <!-- SHOP -->

    <section class="asimetric-section shop">
      <div class="content-wrapper">
        <div class="shop__header stack">
          <h2 >Tienda <br>solidaria</h2>
          <p class="body-m">
            Los beneficios se destinan a apoyar a protectoras de galgos en
            España, financiando rescates, tratamientos y cuidados urgentes.
            <br /><br />Comprar en nuestra tienda es transformar un gesto
            cotidiano en una segunda oportunidad.
          </p>
          
        </div>
        <Carruseltienda />
      </div>
    </section>

    <!-- ADOPTIONS -->

<section class="section adoptions">
  <div class="content-wrapper">
    
      <CarruselFull></CarruselFull>
    
  </div>
</section>


    <!-- HELP -->
    <section class="section help card-grid" id="como-ayudar">
      <div class="section__header stack">
        <h2>¿Cómo puedo ayudar?</h2>
      </div>

      <div class="content-wrapper">
        <div class="stack">
          <IconoTexto
            title="Económico"
            description="Donaciones o aportaciones periódicas."
            icon="ph ph-credit-card"
          />
        </div>
        <div class="stack">
          <IconoTexto
            title="Material"
            description="Pienso, medicación, productos de limpieza, accesorios."
            icon="ph ph-bone"
          />
        </div>
        <div class="stack">
          <IconoTexto
            title="Voluntariado"
            description="Tiempo, transporte, casas de acogida."
            icon="ph ph-hand-heart"
          />
        </div>
        <div class="stack">
          <IconoTexto
            title="Visibilidad"
            description="Ayudar a difundir la causa en redes, prensa y eventos."
            icon="ph ph-eye"
          />
        </div>
      </div>
    </section>

    <!-- DONATIONS -->

    <section class="section donations">
      <div class="content-wrapper">
        <div class="stack donation-card donation-card__teaming">
          <img src="/assets/teaming-logo.png" alt="" class="teaming-logo" />
            <div class="donation-card__content">
            <h3 class="heading-m">Aportación mensual</h3>
            <p class="body-m">
              Desde 1€ al mes a través de Teaming, da estabilidad continua a las protectoras.
            </p>
            <a
              href="https://www.teaming.net/latidoenboxes"
              class="btn " target="_blank" rel="noopener noreferrer">
              Súmate al latido<i class="ph ph-heart"></i></a
            >
          </div>
        
        </div>
        <div class="stack donation-card donation-card__bizum">
          <img src="/assets/bizum-logo.svg" alt="" class="teaming-logo" />
            <div class="donation-card__content">
            <h3 class="heading-m">Aportación puntual</h3>
            <p class="body-m">
             Envía tu aportación al instante por Bizum, sin registrarte en ninguna plataforma.
            </p>
            <a
              class="btn" target="_blank" id="copiarBizum">
             <span>Copiar - 612 345 678</span><i class="ph ph-copy"></i></a
            >
          </div>
        </div>


      </div>
    </section>

<!-- FOOTER -->

    <footer class="section footer">
      
        <div class="content-wrapper">
          <div class="footer__info stack">
            <h2 >¡Síguenos para estar al día!</h2>
            <p class="body-m">
              Los sorteos y todas las comunicaciones relacionadas se anuncian
              exclusivamente a través de nuestras redes sociales.
            </p>
            <div class="social-link ">
              <a
                href="https://www.instagram.com/latidoenboxes/"
                class="link " target="_blank" rel="noopener noreferrer">
                <i class="ph ph-instagram-logo link__icon "></i>
                <span class="body-m">@latidoenboxes</span>
          </a>
              
            </div>
         
          </div>

          <div class="footer__contact stack">
            <h3 class="heading-m">¿Tienes dudas? Contacta con nosotros</h3>
            <Formulario />
          </div>
        </div>
        <div class="content-wrapper">
          <nav class="footer__legal">
            <a href="#" class="link">Aviso legal</a>
              
              <a href="#" class="link">Política de cookies</a>
               <a href="#" class="link">Política de privacidad</a>
          </nav>
        </div>
      
    </footer>

    <script src="/src/scripts/script.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"
    ></script>
  </body>
</html>


<script>
  const boton = document.getElementById("copiarBizum");

boton.addEventListener("click", async () => {
    const numero = "612 345 678";

    try {
        await navigator.clipboard.writeText(numero);

        boton.querySelector("span").textContent = "¡Copiado!";

        setTimeout(() => {
            boton.querySelector("span").textContent = "copiar - 612 345 678";
        }, 2000);

    } catch (error) {
        console.error("No se pudo copiar:", error);
    }
});






</script>