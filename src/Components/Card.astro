---
const {title, description, price, img} = Astro.props
---

<div class="card__container">
    <div class="card__image">
        <img src={img} alt="">
        
    </div>
    <div class="card__content">
        <div class="card__info">
        <h3 class="name heading-m">{title}</h3>
        <p class="description body-s">{description}</p>
        </div>
     
       <p class="price body-l">{price}</p>
    </div>  
</div>

<style>
.card__container {
    background-color: var(--gray-100);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    overflow: hidden;
    border-radius: var(--radius-l);
    transition: all .15s ease;
     
    
    height: 100%;
&:hover {
    transform: scale(0.99);
    box-shadow: var(--shadow-m);
}
}

.card__content {

    display: flex;
    flex-direction: column;
    gap: var(--space-4);
   padding: var(--space-5);
   padding-top: 0;
   flex-grow: 1;


   
    
    


.description {
   
    color: var(--text-secondary);
    
} 
.price {
    
    color: var(--primary);
   
}
.card__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex-grow: 1;
    

}

}


.card__image {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);

     img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: var(--radius-m);
   
    
}
}

@media (max-width: 767px) {

 .card__content {
   gap: var(--space-2);
 }
}



</style>
