---
const {name, age, location, img} = Astro.props
---

<article class="adoption-card">
    <div class="adoption-card__image">
        <img src={img} alt="">
        
    </div>
    <div class="adoption-card__content">
        
        <h3 class="name heading-m">{name}</h3>
        <div class="adoption-card__meta">
           <span class="body-s"><i class="ph-bold ph-cake"></i>{age}</span>
           <span class="body-s"><i class="ph-bold ph-house-line"></i>{location}</span>
        </div>
    
    </div>

</article>

<style>

.adoption-card {
    transition: all .2s ease;
    overflow: hidden;
     border-radius: var(--radius-l);

    &:hover {
        transform: var(--card-scale);
        box-shadow: var(--shadow-m);
    }
}    

.adoption-card__image {
  position: relative;
 
}

.adoption-card__image img {
  display: block;
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  
}

.adoption-card__content {
  position: absolute;
  left: var(--space-3);
  right: var(--space-3);
  bottom: var(--space-3);
display: flex;
flex-direction: column;
gap: var(--space-3);
  padding: var(--space-4);
  padding-right: var(--space-5);
  background: var(--gray-100);
  border-radius: var(--radius-m);
  width: fit-content;

}

.adoption-card__meta {
    display: flex;
    flex-direction: row;
    gap: var(--space-5);

    i {
        font-size: 1.2em;
         color: var(--text-secondary);
    }
}

.name {

    line-height: var(--leading-tighter);
}

.adoption-card__meta span {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-1);
    color: var(--text-secondary);
}



</style>

