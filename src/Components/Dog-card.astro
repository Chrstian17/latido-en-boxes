---
const {name, age, location, img} = Astro.props
---

<div class="card-container">
    <div class="card__image">
        <img src={img} alt="">
        
    </div>
    <div class="card__content">
        
        <h3 class="name heading-m">{name}</h3>
        <div class="age">
            <i class="ph-bold ph-cake"></i><p class="body-m">{age}</p>
        </div>
        <div class="location">
        <i class="ph-bold ph-house-line"></i><p class="body-m">{location}</p>
        </div>
        
     
       
    
</div>

<style>
.card-container {
    background-color: var(--gray-100);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    overflow: hidden;
    border-radius: var(--radius-l);
    transition: all .2s ease;
    
    height: 100%;
&:hover {
    transform: scale(.98);
    box-shadow: var(--shadow-s);
}
}

.card__content {

    display: flex;
    flex-direction: column;
    gap: var(--space-0);
    padding: 0 2rem 1.4rem 1.4rem;
   flex-grow: 1;
    
    
h3 {
    
    margin-bottom: var(--space-2);
    
}

.age, .location {
    
    color: var(--text-secondary);
    display: flex;
    flex-direction: row;
    gap: var(--space-2);
    align-items: center;

    i {
        color: var(--text-secondary);
        
    }
    
} 

}


.card__image {
    display: flex;
    flex-direction: column;
    gap: .2rem;

     img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
   
    margin-bottom: 1rem;
}
}




</style>
