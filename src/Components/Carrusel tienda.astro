---
import Card from "../Components/Card.astro";
---

<div class="swiper swiper--shop">
  <!-- Additional required wrapper -->
  <div class="swiper-wrapper">
    <!-- Slides -->

    <div class="swiper-slide">
      <Card
        title="Pegatina para coche"
        description="Disponemos de tres tallas para que puedas seleccionar el collar que mejor se adapte a las características únicas de tu mascota. "
        price="1'99 €"
        img="/assets/pegatina-cristal.png"
      />
    </div>
      <div class="swiper-slide">
      <Card
        title="Bidón de acero inox"
        description="Collar para perro, Galgos, fabricado artesanalmente en piel auténtica, con detalle de Galgos bordado."
        price="19'90 €"
        img="/assets/botella.png"
      />
    </div>
     <div class="swiper-slide">
      <Card
        title="Funda de cojín"
        description="Nuestro protector patas perro nutre intensamente las almohadillas secas, agrietadas o irritadas. "
        price="7'99 €"
        img="/assets/cojin.png"
      />
    </div>
      <div class="swiper-slide">
      <Card
        title="Camiseta de tirantes"
        description="El discreto collar de piel de vacuno de alta calidad es ideal debido a su forma especial para todos los galgos."
        price="xx'xx €"
        img="/assets/camiseta.png"
      />
    </div>
      <div class="swiper-slide">
      <Card
        title="Adhesivo de galgos"
        description="Arnés para perros diseñado para el máximo confort, de nailon resistente y robusto, forma ergonómica con suave acolchado, muy cómodo para el animal"
        price="xx'xx €"
        img="/assets/pegatina-coche.png"
      />
    </div>
 
          <div class="swiper-slide">
      <Card
        title="Bandolera chic"
        description="¡Chuckit! Crea juguetes interactivos y atractivos para perros que forjan vínculos duraderos entre las personas y sus mascotas."
        price="xx'xx €"
        img="/assets/bolsa.png"
      />
    </div>
 
  </div>
  <div class="swiper-nav">
    <button class="swiper-arrow btn btn--inverse is-prev"
      ><i class="ph-bold ph-caret-left"></i></button
    >
    <button class="swiper-arrow btn btn--inverse is-next"
      ><i class="ph-bold ph-caret-right"></i></button
    >
  </div>
</div>

<style>
  .swiper--shop .swiper-arrow {
    padding: var(--space-4);
  
    display: flex;
    cursor: pointer;
  }

  .swiper--shop .swiper-nav {
  display: flex;
flex-direction: row;
gap: var(--space-2);
justify-content: start;
padding-bottom: var(--space-4);
i {

 
 font-size: 1.5rem;
 
}

  }

  .swiper {
    width: 100%;

    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .swiper--shop .swiper-slide {
    align-content: center;
    width: 100%;
    height: auto;

   
  }
  .swiper img {
    width: 100%;
    
  }



</style>
